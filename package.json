{
  "name": "frontpage-strikes-back",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest --run",
    "test:e2e": "PLAYWRIGHT_TEST=true PLAYWRIGHT_HTML_OPEN=never playwright test --reporter=list",
    "test:cleanup": "bun run src/tests/cleanup-user.ts",
    "coverage": "vitest run --coverage",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed": "bun run src/db/seed.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "type-check": "bun tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write --unsafe",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --unsafe --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-email/components": "^1.0.12",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.2",
    "@trigger.dev/sdk": "4.5.4",
    "better-auth": "^1.6.23",
    "check-password-strength": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "highlight.js": "^11.11.1",
    "html-to-text": "^10.0.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "normalize-url": "^9.0.1",
    "nuqs": "^2.9.0",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.81.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-virtuoso": "^4.18.10",
    "resend": "^6.17.2",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unique-names-generator": "^4.7.1",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
